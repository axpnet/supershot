#: src/capture.rs:624
msgid "The desktop screenshot portal is not responding."
msgstr "Портал скриншотов рабочего стола не отвечает."

#: src/capture.rs:626
msgid ""
"SuperShot is running inside a __CHANNEL__ sandbox, so it cannot "
"use                  command-line screenshot tools installed on the host. "
"Install an XDG desktop                  portal backend for your desktop "
"environment (xdg-desktop-portal-gnome,                  xdg-desktop-portal-"
"kde, xdg-desktop-portal-wlr or xdg-desktop-portal-gtk)                  and "
"restart your session."
msgstr ""

#: src/capture.rs:643
msgid "Every available screenshot tool failed to produce an image."
msgstr "Ни один из доступных инструментов не смог сделать снимок."

#: src/capture.rs:645
msgid "No screenshot tool is available for this session."
msgstr "Для этого сеанса нет доступных инструментов снимка экрана."

#: src/capture.rs:651
msgid "Mode: __MODE__ · Display server: __BACKEND__"
msgstr "Режим: __MODE__ · Графический сервер: __BACKEND__"

#: src/capture.rs:664
msgid "Install a desktop portal backend, or one of: __TOOLS__"
msgstr "Установите бэкенд портала рабочего стола или один из: __TOOLS__"

#: src/capture.rs:716
msgid "For example: __CMD__"
msgstr "Например: __CMD__"

