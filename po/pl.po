msgid "The capture could not be opened."
msgstr "Nie można otworzyć zrzutu."

#: src/preview.rs:905
msgid "Pick a tool, mark up the shot, then Save or Copy."
msgstr "Wybierz narzędzie, oznacz zrzut, następnie Zapisz lub Kopiuj."

#: src/preview.rs:1269
msgid "Drag a region, then click inside it or press Apply Crop."
msgstr "Zaznacz obszar, kliknij w nim lub naciśnij Zastosuj przycięcie."

#: src/preview.rs:1270
msgid "Type the label, then click on the image to place it."
msgstr "Wpisz etykietę, następnie kliknij obraz, aby ją umieścić."

#: src/preview.rs:1271
msgid "Click to drop the next numbered marker."
msgstr "Kliknij, aby wstawić kolejny numerowany znacznik."

#: src/preview.rs:1272
msgid "Drag over sensitive data. Pixels are destroyed, not covered."
msgstr "Przeciągnij po wrażliwych danych. Piksele są niszczone, nie zakrywane."

#: src/preview.rs:1273
msgid "Drag to cover a region with solid colour."
msgstr "Przeciągnij, aby zakryć obszar jednolitym kolorem."

#: src/preview.rs:1274
msgid "Drag on the image to draw."
msgstr "Przeciągnij po obrazie, aby rysować."

#: src/preview.rs:1422
msgid "Type the label text first, then click to place it."
msgstr "Najpierw wpisz tekst etykiety, potem kliknij, aby ją umieścić."

#: src/preview.rs:1555
msgid "__W__ × __H__ px"
msgstr "__W__ × __H__ px"

