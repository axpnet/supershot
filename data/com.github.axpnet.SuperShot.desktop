[Desktop Entry]
Type=Application
Name=SuperShot
GenericName=Screenshot Tool
GenericName[it]=Strumento di cattura schermo
GenericName[fr]=Outil de capture d'écran
GenericName[de]=Bildschirmfoto-Werkzeug
GenericName[es]=Herramienta de capturas
GenericName[pt]=Ferramenta de capturas
GenericName[ru]=Инструмент снимков экрана
GenericName[pl]=Narzędzie do zrzutów ekranu
GenericName[tr]=Ekran görüntüsü aracı
GenericName[ja]=スクリーンショットツール
GenericName[ko]=스크린샷 도구
GenericName[zh_CN]=截图工具
GenericName[zh_TW]=螢幕擷取工具
GenericName[hi]=स्क्रीनशॉट टूल
GenericName[id]=Alat Tangkapan Layar
Comment=Capture, annotate and share screenshots
Comment[it]=Cattura, annota e condividi screenshot
Comment[fr]=Capturer, annoter et partager des captures d'écran
Comment[de]=Bildschirmfotos aufnehmen, kommentieren und teilen
Comment[es]=Capture, anote y comparta capturas de pantalla
Comment[pt]=Capture, anote e partilhe capturas de ecrã
Comment[ru]=Создание, аннотирование и отправка снимков экрана
Comment[pl]=Rób, opisuj i udostępniaj zrzuty ekranu
Comment[tr]=Ekran görüntüsü alın, işaretleyin ve paylaşın
Comment[ja]=スクリーンショットの撮影、注釈、共有
Comment[ko]=스크린샷 캡처, 주석 달기, 공유
Comment[zh_CN]=截取、标注并分享屏幕截图
Comment[zh_TW]=擷取、標註並分享螢幕畫面
Comment[hi]=स्क्रीनशॉट लें, एनोटेट करें और साझा करें
Comment[id]=Ambil, anotasi, dan bagikan tangkapan layar
Exec=supershot
Icon=com.github.axpnet.SuperShot
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;GTK;
Keywords=screenshot;capture;screen;snip;annotate;crop;watermark;redact;
Keywords[it]=schermata;cattura;schermo;ritaglia;annota;filigrana;oscura;
Keywords[fr]=capture;écran;rogner;annoter;filigrane;masquer;
Keywords[de]=Bildschirmfoto;Aufnahme;zuschneiden;kommentieren;Wasserzeichen;
Keywords[es]=captura;pantalla;recortar;anotar;marca de agua;
Keywords[pt]=captura;ecrã;recortar;anotar;marca de água;
Keywords[ru]=снимок;экран;обрезка;аннотация;водяной знак;
Keywords[pl]=zrzut;ekran;przytnij;adnotacja;znak wodny;
Keywords[tr]=ekran görüntüsü;yakala;kırp;işaretle;filigran;
Keywords[ja]=スクリーンショット;画面;切り抜き;注釈;透かし;
Keywords[ko]=스크린샷;화면;자르기;주석;워터마크;
Keywords[zh_CN]=截图;屏幕;裁剪;标注;水印;
Keywords[zh_TW]=螢幕擷取;畫面;裁切;標註;浮水印;
Keywords[hi]=स्क्रीनशॉट;स्क्रीन;क्रॉप;एनोटेट;वॉटरमार्क;
Keywords[id]=tangkapan layar;layar;pangkas;anotasi;tanda air;
StartupNotify=true
StartupWMClass=com.github.axpnet.SuperShot
DBusActivatable=true
X-GNOME-UsesNotifications=true
Actions=area;window;screen;

[Desktop Action area]
Name=Capture an Area
Name[it]=Cattura un'area
Name[fr]=Capturer une zone
Name[de]=Bereich aufnehmen
