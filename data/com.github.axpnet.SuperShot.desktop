Name[pt]=Capturar uma área
Name[ru]=Снимок области
Name[pl]=Przechwyć obszar
Name[tr]=Bir alan yakala
Name[ja]=範囲を撮影
Name[ko]=영역 캡처
Name[zh_CN]=截取区域
Name[zh_TW]=擷取區域
Name[hi]=एक क्षेत्र कैप्चर करें
Name[id]=Tangkap Area
Exec=supershot --now --mode area

